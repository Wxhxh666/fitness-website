# ---------- 运行环境 ----------
# development / testing / production（默认 production，缺密钥会拒绝启动）
APP_ENV=development
FLASK_DEBUG=1

# ---------- 安全密钥（必填，生产环境缺失将拒绝启动） ----------
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 注意：JWT_SECRET 一旦泄露，务必立即更换（已签发的 token 会全部失效）
SECRET_KEY=replace-with-64-hex-chars
JWT_SECRET=replace-with-64-hex-chars

# ---------- 数据库 ----------
DB_PASSWORD=your_mysql_password
# DB_USER=root
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=fitluxe
# 也可以直接给完整连接串，优先级高于上面各项
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/fitluxe?charset=utf8mb4

# ---------- 前端跨域白名单（逗号分隔） ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:4173

# ---------- AI ----------
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MOCK=1          # 置 1 时强制使用演示方案，不消耗额度
# 火山方舟（可选，配置后可在偏好里切换 doubao-lite）
# DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-lite

# ---------- 上传与限流 ----------
# UPLOAD_IMAGE_MAX_BYTES=2097152
# UPLOAD_VIDEO_MAX_BYTES=209715200
# UPLOAD_DAILY_QUOTA=50
# RATE_LIMIT_ENABLED=1
